# Copy this file to ".env" on the server and fill in your real domain.
#   cp .env.example .env

# The domain you pointed at the VPS (no http://, no trailing slash).
# Used for HTTPS, the allowed CORS/Socket origin, and the frontend API URL.
DOMAIN=vgctool.example.com

# Optional. Unlocks the admin-guarded sync endpoints (POST /api/regulations/sync,
# /api/tournaments/sync-now, /api/tournaments/resync-standings, etc). Leave unset
# to keep them disabled (fail-closed). If set, requests must send a matching
# `x-admin-token` header. Pick any long random string.
ADMIN_TOKEN=
